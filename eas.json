{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "internal": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6790955096",
        "appleTeamId": "94MS8P8TZZ"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6790955096",
        "appleTeamId": "94MS8P8TZZ"
      }
    }
  }
}
