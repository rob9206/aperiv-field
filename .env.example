# Copy to .env and fill in. EXPO_PUBLIC_* vars are embedded in the JS bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Enable only after the matching database migration and web changes are deployed.
EXPO_PUBLIC_FIELD_SUBMISSION_ENABLED=false
